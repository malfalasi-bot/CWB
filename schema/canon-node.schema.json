  "x-period-bands": [
    {
      "code": "B01",
      "label": "before 8000 BCE",
      "start": -10000000,
      "end": -8000
    },
    {
      "code": "B02",
      "label": "8000-4000 BCE",
      "start": -8000,
      "end": -4000
    },
    {
      "code": "B03",
      "label": "4000-2000 BCE",
      "start": -4000,
      "end": -2000
    },
    {
      "code": "B04",
      "label": "2000-1000 BCE",
